<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Le XML anglais va dans le dossier satellite lib/net10.0/en/ -->
    <None Include="docs\FlashCsv.Annotations.en.xml" Pack="true" PackagePath="lib/net10.0/en/FlashCsv.Annotations.xml" />
  </ItemGroup>
</Project>
