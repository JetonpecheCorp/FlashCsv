<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Le XML anglais va dans le dossier satellite lib/net10.0/en/ -->
    <None Include="docs\FlashCsv.Core.en.xml" Pack="true" PackagePath="lib/net10.0/en/FlashCsv.Core.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlashCsv.Annotations\FlashCsv.Annotations.csproj" />
  </ItemGroup>
</Project>
