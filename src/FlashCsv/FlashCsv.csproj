<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    
    <!-- Identité du package NuGet -->
    <PackageId>FlashCsv</PackageId>
    <Version>1.0.0</Version>
    <Authors>jetonpeche</Authors>
    <Title>FlashCsv</Title>
    <Description>Ultra high-performance, zero-allocation CSV parser, streamer, and serializer for .NET. 100% Native AOT compatible with compile-time Roslyn Source Generators and SIMD acceleration.</Description>
    <PackageTags>csv;fast;aot;nativeaot;sourcegenerator;performance;simd;zero-allocation;streaming;parser;serializer</PackageTags>
    <PackageReleaseNotes>Initial release of FlashCsv 1.0.0:
- Ultra high-performance zero-allocation CSV reader, writer, and asynchronous streamer (IAsyncEnumerable).
- 100% Native AOT compatible with zero runtime reflection via Roslyn incremental Source Generators.
- Clean POCO models with no mandatory interfaces or generic constraints.
- Advanced capabilities: nested flattening ([CsvFlatten]), JSON columns ([CsvJson]), polymorphic records ([CsvDiscriminator]), delimiter sniffing, Excel formula injection protection, string pooling, and SqlBulkCopy streaming (DbDataReader).
- Localized XML documentation support (English and French).</PackageReleaseNotes>
    
    <!-- Licences et Référentiel -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/JetonpecheCorp/FlashCsv</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JetonpecheCorp/FlashCsv</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    
    <!-- Documentation & Logo embarqués -->
    <PackageIcon>logoFlashCsv.png</PackageIcon>
    <Copyright>Copyright © 2026 Jetonpeche. All rights reserved.</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    
    <!-- Métadonnées & Symboles -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Inclusion automatique des dépendances internes dans le nupkg -->
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <!-- Fichiers statiques intégrés au package -->
  <ItemGroup>
    <None Include="..\..\assets\logoFlashCsv.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\README.en.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\FlashCsv.Annotations\docs\FlashCsv.Annotations.en.xml" Pack="true" PackagePath="lib/net10.0/en/FlashCsv.Annotations.xml" Visible="false" />
    <None Include="..\FlashCsv.Core\docs\FlashCsv.Core.en.xml" Pack="true" PackagePath="lib/net10.0/en/FlashCsv.Core.xml" Visible="false" />
  </ItemGroup>

  <!-- Références internes -->
  <ItemGroup>
    <ProjectReference Include="..\FlashCsv.Annotations\FlashCsv.Annotations.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FlashCsv.Core\FlashCsv.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FlashCsv.Generators\FlashCsv.Generators.csproj" 
                      OutputItemType="Analyzer" 
                      ReferenceOutputAssembly="false" 
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- Le Source Generator : automatiquement injecté par Roslyn via analyzers/dotnet/cs -->
  <ItemGroup>
    <None Include="..\FlashCsv.Generators\bin\$(Configuration)\netstandard2.0\FlashCsv.Generators.dll" 
          PackagePath="analyzers/dotnet/cs" 
          Pack="true" 
          Visible="false" />
    <None Include="build\FlashCsv.targets" PackagePath="build" Pack="true" Visible="false" />
    <None Include="build\FlashCsv.targets" PackagePath="buildTransitive" Pack="true" Visible="false" />
  </ItemGroup>

  <!-- Cible de copie des DLLs des sous-projets dans lib/net10.0/ -->
  <Target Name="CopyProjectReferencesToPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
    </ItemGroup>
  </Target>

</Project>